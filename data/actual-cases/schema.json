{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daham Actual Funeral Case",
  "type": "object",
  "required": ["id","event_month","region","funeral_hall","funeral_type","publication"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9-]+$"},
    "event_month": {"type":"string","pattern":"^\\d{4}-\\d{2}$"},
    "region": {"type":"string","minLength":1},
    "district": {"type":"string"},
    "funeral_hall": {"type":"string","minLength":1},
    "funeral_hall_page": {"type":"string"},
    "region_page": {"type":"string"},
    "funeral_type": {"enum":["무빈소","가족장","일반장","프리미엄","기타"]},
    "duration_days": {"type":["integer","null"],"minimum":1,"maximum":10},
    "guest_count": {"type":["integer","null"],"minimum":0},
    "package": {
      "type":"object",
      "properties":{
        "name":{"type":"string"},
        "amount":{"type":["integer","null"],"minimum":0}
      },
      "additionalProperties":false
    },
    "costs": {
      "type":"object",
      "properties":{
        "funeral_hall":{"type":["integer","null"],"minimum":0},
        "food_reception":{"type":["integer","null"],"minimum":0},
        "cremation":{"type":["integer","null"],"minimum":0},
        "vehicle":{"type":["integer","null"],"minimum":0},
        "cemetery_columbarium":{"type":["integer","null"],"minimum":0},
        "optional":{"type":["integer","null"],"minimum":0},
        "discount":{"type":["integer","null"],"minimum":0},
        "total_paid":{"type":["integer","null"],"minimum":0}
      },
      "additionalProperties":false
    },
    "verified_line_items":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["label","amount"],
        "properties":{
          "label":{"type":"string"},
          "amount":{"type":"integer","minimum":0},
          "category":{"enum":["package","funeral_hall","food_reception","cremation","vehicle","cemetery_columbarium","optional","discount","other"]},
          "source":{"enum":["receipt","user_confirmed","facility_document"]}
        },
        "additionalProperties":false
      }
    },
    "photos":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["path","category","alt","privacy_checked"],
        "properties":{
          "path":{"type":"string"},
          "category":{"enum":["exterior","interior","altar","mourning_room","reception","wreaths","coffin","departure","vehicle","crematorium","cemetery","urn","documents","other"]},
          "alt":{"type":"string"},
          "privacy_checked":{"type":"boolean"}
        },
        "additionalProperties":false
      }
    },
    "receipt_public_image":{"type":["string","null"]},
    "notes_public":{"type":"array","items":{"type":"string"}},
    "publication":{
      "type":"object",
      "required":["publish","privacy_reviewed","costs_verified","explicit_photo_permission"],
      "properties":{
        "publish":{"type":"boolean"},
        "privacy_reviewed":{"type":"boolean"},
        "costs_verified":{"type":"boolean"},
        "explicit_photo_permission":{"type":"boolean"},
        "reviewed_at":{"type":["string","null"]}
      },
      "additionalProperties":false
    },
    "facility_identity":{
      "type":"object",
      "required":["facilityName","address","officialBranchName","sourceUrl","facilityCode"],
      "properties":{
        "facilityName":{"type":"string","minLength":1},
        "address":{"type":"string","minLength":1},
        "officialBranchName":{"type":"string","minLength":1},
        "sourceUrl":{"type":"string","format":"uri","pattern":"^https://"},
        "facilityCode":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false,
  "allOf":[{
    "if":{"properties":{"publication":{"properties":{"publish":{"const":true}}}}},
    "then":{"required":["facility_identity"]}
  }]
}
